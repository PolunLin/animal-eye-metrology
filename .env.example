# Docker Compose reads this file after copying it to .env.
# No account, API key or password is required for this local demonstration.
UI_PORT=8517
API_PORT=8000
WEIGHTS_DIRECTORY=./weights
DATA_DIRECTORY=./data
OUTPUTS_DIRECTORY=./outputs
AEM_WORKSPACE=New Image Inference
# For local Python launches, export this variable (Python does not auto-load .env).
AEM_INFERENCE_CONFIG=configs/inference.runtime.toml
